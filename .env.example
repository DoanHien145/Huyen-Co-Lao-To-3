# ==========================================
# CẤU HÌNH BOT DISCORD TU TIÊN AI (GROQ SDK)
# ==========================================

# 1. Discord Bot Token (Lấy từ https://discord.com/developers/applications)
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"

# 2. Groq API Key (Lấy miễn phí tại https://console.groq.com/keys)
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"

# 3. Channel ID (ID của kênh Discord duy nhất mà Bot phản hồi, để 0 hoặc trống nếu muốn phản hồi mọi channel khi @mention)
CHANNEL_ID="1234567890123456789"
